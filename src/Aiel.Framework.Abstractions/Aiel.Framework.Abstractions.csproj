<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace />
        <AssemblyName>Aiel.Framework.Abstractions</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <!--
        Intentionally disabling Implicit Usings to support Aiel.Framework.UnitTests.Stubs
        which includes source code from Aiel.Framework.Abstractions
        -->
        <ImplicitUsings>disable</ImplicitUsings>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="./README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <!--
    Include the analyzer and generator DLLs in the NuGet package so consuming projects
    automatically load and run them. Any assembly packed under analyzers/dotnet/cs is
    picked up as an analyzer by the .NET SDK/NuGet by convention, so no additional
    .props/.targets file is required (adding <Analyzer> items manually would double-load
    them and, with a wrong path, causes CS0006 in consuming projects).
    -->
    <ItemGroup>
        <!-- Temporarily disabling analyzers until I figure out which one is crashing the diagnostic runner.
        <None Include="..\Aiel.Framework.Analyzers\bin\$(Configuration)\netstandard2.0\Aiel.Framework.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        -->
        <None Include="..\Aiel.Framework.Generators\bin\$(Configuration)\netstandard2.0\Aiel.Framework.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

    <!--
    The ProjectReferences (with ReferenceOutputAssembly=false) only enforce build ordering so
    the DLLs exist when this project is packed; they are not compile-time references and are
    not themselves packed as dependencies.
    -->
    <ItemGroup>
        <!-- Temporarily disabling analyzers until I figure out which one is crashing the diagnostic runner.
        <ProjectReference Include="..\Aiel.Framework.Analyzers\Aiel.Framework.Analyzers.csproj" ReferenceOutputAssembly="false" Pack="false" PrivateAssets="all" />
        -->
        <ProjectReference Include="..\Aiel.Framework.Generators\Aiel.Framework.Generators.csproj" ReferenceOutputAssembly="false" Pack="false" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    </ItemGroup>

</Project>
