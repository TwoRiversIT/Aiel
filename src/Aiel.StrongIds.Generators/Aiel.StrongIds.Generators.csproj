<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace />
        <AssemblyName>Aiel.StrongIds.Generators</AssemblyName>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IsGenerator>true</IsGenerator>
        <IsPackable>true</IsPackable>

        <!--
        These are settings specific to analyzers/code fixes/source generators. IncludeBuildOutput is false
        to prevent the DLL landing in lib/, but the assembly is explicitly packed into analyzers/dotnet/cs.
        Source generators cannot be deterministic because they embed timestamps.
        -->
        <Deterministic>false</Deterministic>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsRoslynComponent>true</IsRoslynComponent>
        <DevelopmentDependency>true</DevelopmentDependency>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <NoWarn>$(NoWarn);NU5128;RS2000</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="./README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <!-- BEGIN: Generator specific settings -->
    <ItemGroup>
        <Compile Remove="bin\**" />
        <EmbeddedResource Remove="bin\**" />
        <None Remove="bin\**" />
        <None Remove="bin\Debug\netstandard2.0\" />
        <None Remove="bin\Debug\netstandard2.0\$(AssemblyName).dll" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <Compile Include="..\Aiel.SharedCode\Aiel\CodeAnalysis\ITypeSymbolExtensions.cs" Pack="false" Path="\Aiel\CodeAnalysis\ITypeSymbolExtensions.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.6.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    </ItemGroup>
    <!-- END: Generator specific settings -->

</Project>
