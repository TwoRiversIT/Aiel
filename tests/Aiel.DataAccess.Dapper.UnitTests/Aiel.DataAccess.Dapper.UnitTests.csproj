<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace />
        <AssemblyName>Aiel.DataAccess.Dapper.UnitTests</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="appsettings.Testing.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.Testing.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!--
        Microsoft.Data.Sqlite v10.0.9 package has a transitive dependency on SQLitePCLRaw.lib.e_sqlite3 v2.1.11,
        which contains a known high severity security vulnerability (GHSA-2m69-gcr7-jv3q). Adding a direct 
        dependency on SQLitePCLRaw.lib.e_sqlite3 version 3.50.3, which is the patched version, overrides the
        transitive dependency from Microsoft.Data.Sqlite and ensures we are using the secure version.
        -->
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\..\src\Aiel.Framework.Abstractions\Aiel.Framework.Abstractions.csproj" />
        <ProjectReference Include="..\..\src\Aiel.DataAccess.Dapper\Aiel.DataAccess.Dapper.csproj" />
        <ProjectReference Include="..\..\src\Aiel.Testing\Aiel.Testing.csproj" />
    </ItemGroup>

</Project>
