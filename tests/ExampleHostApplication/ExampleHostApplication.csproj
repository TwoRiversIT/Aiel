    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Aiel.Framework.Analyzers\Aiel.Framework.Analyzers.csproj" OutputItemType="Analyzer" />
        <ProjectReference Include="..\..\src\Aiel.Framework.Generators\Aiel.Framework.Generators.csproj" OutputItemType="Analyzer" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Aiel.DataAccess.EntityFrameworkCore\Aiel.DataAccess.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\..\src\Aiel.Framework.HostApplication\Aiel.Framework.HostApplication.csproj" />
        <ProjectReference Include="..\..\src\Aiel.Security\Aiel.Security.csproj" />
    </ItemGroup>

</Project>
